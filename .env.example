# PaperBoxd backend config. Copy to .env and fill in. Non-secret example only —
# never commit real secrets. Keys mirror internal/config/config.go.

# --- Server ---
PORT=8080
ENVIRONMENT=development

# --- Postgres ---
DATABASE_URL=postgres://user:pass@localhost:5432/paperboxd?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# --- Redis ---
REDIS_URL=localhost:6379
REDIS_PASSWORD=

# --- Auth / JWT ---
JWT_SECRET=            # required, min 32 chars
TOKEN_EXPIRY_MOBILE=720h
INTERNAL_SECRET=       # shared secret for web /auth/google server-to-server call

# ============================================================================
# !! REQUIRED for mobile Google sign-in. Comma-separated Google client IDs.
# !! EMPTY / UNSET = every Google token rejected (fail-closed) => Google login
# !! silently breaks on mobile. If mobile Google sign-in 401s, CHECK THIS FIRST.
# !! iOS client ID now; append the Android Web-type serverClientId in Handoff B.
# ============================================================================
GOOGLE_OAUTH_ALLOWED_AUDIENCES=

# --- Third-party APIs ---
GOOGLE_BOOKS_API_KEY=
ISBNDB_API_KEY=
COHERE_API_KEY=
ANTHROPIC_API_KEY=
BRAVE_API_KEY=
HARDCOVER_API_TOKEN=

# --- Email (Resend). Empty RESEND_API_KEY → NoopMailer (OTP emails no-op). ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=PaperBoxd <onboarding@resend.dev>

# --- Cloudinary (avatar upload). Empty cloud name → upload disabled. ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Misc ---
RATE_LIMIT_PER_MINUTE=100
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
